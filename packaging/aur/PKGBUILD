# Maintainer: Idris Akorede Ibrahim
pkgname=omarchy-habit
pkgver=0.1.0
pkgrel=1
pkgdesc="Local-only active-time tracker for Omarchy with a heatmap panel and bar widget"
arch=('any')
url="https://github.com/korex-f/habit"
license=('MIT')
depends=('omarchy' 'quickshell' 'sqlite' 'dbus' 'xdg-utils' 'jq')
install=omarchy-habit.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "habit-$pkgver"
  local plugin="$pkgdir/usr/share/omarchy-habit/plugin"

  # Runtime files only; specs and tests stay in the repository.
  install -Dm644 manifest.json Service.qml Panel.qml BarWidget.qml -t "$plugin/"
  install -Dm644 components/*.qml -t "$plugin/components/"
  install -Dm644 js/*.js -t "$plugin/js/"

  install -Dm755 bin/omarchy-habit "$pkgdir/usr/bin/omarchy-habit"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
